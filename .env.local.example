# Copy to .env.local and fill in. In Coolify these become the application's
# environment variables (see DEPLOYMENT.md for which ones are build-time).

# Public – needed at BUILD time (Next.js inlines NEXT_PUBLIC_* into the bundle)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-01
# Canonical URL of this deployment, used for metadata. Optional locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secrets – runtime only
# Viewer token: draft previews + Live Content API (Manage → API → Tokens)
SANITY_API_READ_TOKEN=
# Shared secret between the Sanity webhook and /api/revalidate. Any long random string.
SANITY_REVALIDATE_SECRET=

# Set to "true" on preview/develop deployments: adds X-Robots-Tag: noindex to every response
NOINDEX=

# Editor token: only needed locally to run `npm run seed`
SANITY_API_WRITE_TOKEN=
